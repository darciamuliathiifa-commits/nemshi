# Supabase (PostgreSQL) — lihat PRD.md bagian 7 (Tech Stack)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudinary — storage foto portofolio iklan
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment Gateway (Mayar) — biaya publikasi iklan, lihat docs.mayar.id
# Ambil API key di https://web.mayar.id/api-keys (production) atau
# https://web.mayar.club/api-keys (sandbox testing).
# Daftarkan webhook URL di dashboard Mayar (Integration -> Webhook) ke:
# {NEXT_PUBLIC_APP_URL}/api/webhooks/mayar
MAYAR_API_KEY=""
MAYAR_API_HOST="https://api.mayar.id"

# URL absolut aplikasi ini — dipakai untuk redirectUrl saat membuat
# invoice Mayar. Isi dengan domain produksi/staging saat deploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Cron — melindungi /api/cron/expire-listings dari akses publik
CRON_SECRET=""
